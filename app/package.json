{
  "name": "co-vua-3d",
  "productName": "Cờ Vua 3D",
  "version": "1.2.0",
  "description": "Cờ Vua 3D - Stockfridge AI & Đánh Giá Nước Đi",
  "author": "Co Vua 3D",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "prepare-web": "node scripts/prepare.mjs",
    "start": "npm run prepare-web && electron .",
    "dist:win": "npm run prepare-web && electron-builder --win",
    "dist:mac": "npm run prepare-web && electron-builder --mac",
    "dist:linux": "npm run prepare-web && electron-builder --linux",
    "cap:sync": "npm run prepare-web && npx cap sync"
  },
  "build": {
    "appId": "vn.covua3d.app",
    "productName": "Co Vua 3D",
    "files": [
      "electron/**",
      "www/**",
      "package.json",
      "!node_modules/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cờ Vua 3D"
    },
    "portable": {
      "artifactName": "CoVua3D-portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.board-games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.10",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true,
    "sharp@0.32.6": true
  }
}
